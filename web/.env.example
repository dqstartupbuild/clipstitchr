# Canonical environment template
#
# Copy this file to web/.env.local for local development. Never commit
# web/.env.local, production credentials, database URLs, private keys, or
# uploaded media. Use the same headings when configuring Vercel, Convex,
# Cloud Run, Secret Manager, and worker environments.
#
# Values marked PLACEHOLDER must be replaced in the deployment that consumes
# them. Values marked SERVER_ONLY must never be prefixed with NEXT_PUBLIC_.

# -----------------------------------------------------------------------------
# Web app and release metadata
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLIPSTITCHR_APP_URL=http://localhost:3000
CLIPSTITCHR_DEPLOYMENT_ENVIRONMENT=development
NEXT_PUBLIC_SOURCE_CODE_URL=https://github.com/dqstartupbuild/clipstitchr
SOURCE_CODE_REVISION=PLACEHOLDER # exact public release commit
SOURCE_CODE_ARCHIVE_URL=PLACEHOLDER # optional exact public source archive
RATE_LIMIT_API_SECRET=PLACEHOLDER # openssl rand -base64 32
PRIVACY_DELETION_OPERATOR_SECRET=PLACEHOLDER # openssl rand -base64 32
STUDIO_BETA_ENABLED=false # exact lowercase true enables the server-side beta gate
STUDIO_BETA_OPERATOR_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
INDEXNOW_SUBMIT_SECRET=PLACEHOLDER # openssl rand -base64 32
BLOG_PUBLISH_WEBHOOK_TOKEN=PLACEHOLDER # openssl rand -base64 32

# -----------------------------------------------------------------------------
# Clerk identity
# -----------------------------------------------------------------------------
DEV_AUTH_BYPASS_ENABLED=false # local dashboard UI only; development + loopback fail-closed
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=PLACEHOLDER
CLERK_SECRET_KEY=PLACEHOLDER # SERVER_ONLY
CLERK_WEBHOOK_SIGNING_SECRET=PLACEHOLDER # SERVER_ONLY
CLERK_JWT_ISSUER_DOMAIN=PLACEHOLDER
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/onboarding

# -----------------------------------------------------------------------------
# Convex application and worker coordination
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=PLACEHOLDER # production deployment name, not a dev name
CONVEX_URL=https://PLACEHOLDER.convex.cloud # SERVER_ONLY alias
NEXT_PUBLIC_CONVEX_URL=https://PLACEHOLDER.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=PLACEHOLDER
AUTOMATION_WORKER_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
AUTOMATION_NEXT_BASE_URL=http://localhost:3000
PROVIDER_WORKER_SECRET=PLACEHOLDER # Cloud Run worker and Convex must match
MEDIA_WORKER_SECRET=PLACEHOLDER # Cloud Run worker and Convex must match
PROVIDER_GLOBAL_ACTIVE_GENERATION_LIMIT=50
MEDIA_GLOBAL_ACTIVE_GENERATION_LIMIT=50
PROVIDER_TOOL_ACTIVE_GENERATION_LIMITS_JSON=

# -----------------------------------------------------------------------------
# Rate limits, privacy, indexing, and webhooks
# -----------------------------------------------------------------------------
RATE_LIMIT_API_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
PRIVACY_DELETION_OPERATOR_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
INDEXNOW_SUBMIT_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
BLOG_PUBLISH_WEBHOOK_TOKEN=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32

# -----------------------------------------------------------------------------
# Stripe billing
# Test and live values must come from separate Stripe workspaces.
# -----------------------------------------------------------------------------
CLIPSTITCHR_STRIPE_MODE=test
STRIPE_SECRET_KEY=PLACEHOLDER # SERVER_ONLY
STRIPE_WEBHOOK_SECRET=PLACEHOLDER # SERVER_ONLY
STRIPE_PORTAL_CONFIGURATION_ID=PLACEHOLDER
STRIPE_STARTER_PRODUCT_ID=PLACEHOLDER
STRIPE_STARTER_PRICE_ID=PLACEHOLDER
STRIPE_PRO_PRODUCT_ID=PLACEHOLDER
STRIPE_PRO_PRICE_ID=PLACEHOLDER
STRIPE_AGENCY_PRODUCT_ID=PLACEHOLDER
STRIPE_AGENCY_PRICE_ID=PLACEHOLDER
STRIPE_CREATION_CREDIT_REFILL_PRODUCT_ID=PLACEHOLDER
STRIPE_CREATION_CREDIT_REFILL_PRICE_ID=PLACEHOLDER
BILLING_SUPPORT_OPERATOR_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32

# -----------------------------------------------------------------------------
# Email and Loops
# Keep rollout disabled until all readiness checks pass.
# -----------------------------------------------------------------------------
PUBLIC_TOOL_GATE_ROLLOUT=
EMAIL_CONFIRMATION_TOKEN_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
LOOPS_EMAIL_ENABLED=false
LOOPS_API_KEY=PLACEHOLDER # SERVER_ONLY
LOOPS_TEAM_ENVIRONMENT=development
LOOPS_DEVELOPMENT_RECIPIENTS=
LOOPS_SIGNING_SECRET=PLACEHOLDER # SERVER_ONLY
LOOPS_WEBHOOKS_READY=false
LOOPS_CONTACT_PROPERTIES_READY=false
LOOPS_WORKFLOWS_READY=false
LOOPS_EMAIL_NATIVE_ENABLED=false
LOOPS_EMAIL_CONFIRMATION_TRANSACTIONAL_ID=PLACEHOLDER
LOOPS_ACCOUNT_EMAIL_ENABLED=false
LOOPS_ACCOUNT_CREATED_TRANSACTIONAL_ID=PLACEHOLDER
LOOPS_SUBSCRIPTION_STATUS_TRANSACTIONAL_ID=PLACEHOLDER
LOOPS_CREDITS_UPDATED_TRANSACTIONAL_ID=PLACEHOLDER
LOOPS_PAYMENT_ALERT_TRANSACTIONAL_ID=PLACEHOLDER

# -----------------------------------------------------------------------------
# Replicate, Apify, Pexels, and model selection
# -----------------------------------------------------------------------------
REPLICATE_API_TOKEN=PLACEHOLDER # SERVER_ONLY
REPLICATE_UPLOAD_ANALYSIS_MODEL_ID=openai/gpt-5-mini
REPLICATE_UPLOAD_VIDEO_ANALYSIS_MODEL_ID=google/gemini-3-flash
REPLICATE_UPLOAD_VIDEO_FALLBACK_MODEL_ID=lucataco/qwen2-vl-7b-instruct:bf57361c75677fc33d480d0c5f02926e621b2caa2000347cb74aeae9d2ca07ee
PRODUCT_ENRICHMENT_MODEL_ID=PLACEHOLDER
TEXT_WRITING_MODEL_ID=anthropic/claude-sonnet-4.6
CLIPR_HOOK_MODEL_ID=PLACEHOLDER
CLIPR_SCENE_MODEL_ID=PLACEHOLDER
CLIPR_AVATAR_VIDEO_MODEL_ID=PLACEHOLDER
CLIPR_VISUAL_VIDEO_MODEL_ID=kwaivgi/kling-v3-video
CLIPR_TTS_MODEL_ID=elevenlabs/v3
CLIPR_LIP_SYNC_MODEL_ID=pixverse/lipsync
SWIPR_BACKGROUND_MODEL_ID=PLACEHOLDER
AVATAR_PHOTO_MODEL_ID=PLACEHOLDER
PEXELS_API_KEY=PLACEHOLDER # SERVER_ONLY
APIFY_TOKEN=PLACEHOLDER # SERVER_ONLY

# -----------------------------------------------------------------------------
# Cloudflare R2 media storage
# Keep the bucket private. R2 credentials are SERVER_ONLY.
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://PLACEHOLDER.r2.cloudflarestorage.com
R2_BUCKET=PLACEHOLDER
R2_ACCOUNT_ID=PLACEHOLDER
R2_BUCKET_NAME=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER # SERVER_ONLY
R2_SECRET_ACCESS_KEY=PLACEHOLDER # SERVER_ONLY
R2_SIGNED_URL_EXPIRES_SECONDS=PLACEHOLDER

# -----------------------------------------------------------------------------
# Studio publishing web gateway and provider-readable media gateway
# The assertion/media secrets are shared with the publishing service through
# Secret Manager. STUDIO_PUBLISHING_SERVICE_ORIGIN is web-only. These values
# are separate from every Zernio and SOCIAL_PUBLISHING_* value.
# -----------------------------------------------------------------------------
STUDIO_PUBLISHING_SERVICE_ORIGIN=https://studio-publishing-service.example.com # web-only
STUDIO_PUBLISHING_SERVICE_ISSUER=clipstitchr-studio-web-production
STUDIO_PUBLISHING_SERVICE_AUDIENCE=clipstitchr-studio-publishing-production
STUDIO_PUBLISHING_SERVICE_ASSERTION_KEY_BASE64=PLACEHOLDER # shared; openssl rand -base64 32
STUDIO_PUBLISHING_DISPATCH_ACCESS_SECRET=PLACEHOLDER # shared service-to-web secret; openssl rand -base64 32
STUDIO_PUBLISHING_MEDIA_PUBLIC_ORIGIN=https://studio-media.clipstitchr.com
STUDIO_PUBLISHING_MEDIA_TOKEN_SECRET=PLACEHOLDER # shared; openssl rand -base64 48
STUDIO_PUBLISHING_MEDIA_QUOTA_SECRET=PLACEHOLDER # shared; openssl rand -base64 48

# -----------------------------------------------------------------------------
# Long-running Studio publishing service
# The database and Redis values are service-only and must use managed
# production services. Redis must use rediss:// in production. This service
# independently requires the exact global STUDIO_BETA_ENABLED=true value above.
# -----------------------------------------------------------------------------
NODE_ENV=development
STUDIO_PUBLISHING_SERVICE_HOST=0.0.0.0
STUDIO_PUBLISHING_SERVICE_PORT=8080
STUDIO_PUBLISHING_TOKEN_KEY_ID=primary-2026-08
STUDIO_PUBLISHING_TOKEN_KEY_BASE64=PLACEHOLDER # service-only; openssl rand -base64 32
STUDIO_PUBLISHING_REDIS_NAMESPACE=clipstitchr-studio-development
STUDIO_PUBLISHING_ENABLED_PROVIDERS=instagram,tiktok,youtube
STUDIO_PUBLISHING_APP_ORIGIN=http://localhost:3000
STUDIO_PUBLISHING_DATABASE_URL=postgresql://PLACEHOLDER # service-only
STUDIO_PUBLISHING_REDIS_URL=redis://PLACEHOLDER # use rediss:// in production
STUDIO_PUBLISHING_OUTBOX_POLL_MS=1000
STUDIO_PUBLISHING_OUTBOX_LEASE_MS=120000
STUDIO_PUBLISHING_OUTBOX_LEASE_LIMIT=20
STUDIO_PUBLISHING_OUTBOX_CONCURRENCY=4
STUDIO_PUBLISHING_OUTBOX_MAX_DELIVERY_ATTEMPTS=20
STUDIO_PUBLISHING_R2_ACCOUNT_ID=PLACEHOLDER
STUDIO_PUBLISHING_R2_BUCKET_NAME=PLACEHOLDER
STUDIO_PUBLISHING_R2_ACCESS_KEY_ID=PLACEHOLDER # SERVER_ONLY
STUDIO_PUBLISHING_R2_SECRET_ACCESS_KEY=PLACEHOLDER # SERVER_ONLY

# -----------------------------------------------------------------------------
# Studio publishing provider credentials
# The default Instagram path uses Facebook Login credentials. Do not enable
# instagram-standalone unless its separate credentials are intentionally used.
# -----------------------------------------------------------------------------
STUDIO_PUBLISHING_META_GRAPH_API_VERSION=v26.0
STUDIO_PUBLISHING_META_APP_ID=PLACEHOLDER
STUDIO_PUBLISHING_META_APP_SECRET=PLACEHOLDER # SERVER_ONLY
# STUDIO_PUBLISHING_INSTAGRAM_APP_ID=PLACEHOLDER
# STUDIO_PUBLISHING_INSTAGRAM_APP_SECRET=PLACEHOLDER # SERVER_ONLY
STUDIO_PUBLISHING_TIKTOK_CLIENT_ID=PLACEHOLDER
STUDIO_PUBLISHING_TIKTOK_CLIENT_SECRET=PLACEHOLDER # SERVER_ONLY
STUDIO_PUBLISHING_TIKTOK_VERIFIED_MEDIA_ORIGIN=https://studio-media.clipstitchr.com
STUDIO_PUBLISHING_GOOGLE_CLIENT_ID=PLACEHOLDER
STUDIO_PUBLISHING_GOOGLE_CLIENT_SECRET=PLACEHOLDER # SERVER_ONLY

# -----------------------------------------------------------------------------
# Publishing service legacy-name migration notes
# These are not consumed by the current publishing service:
# INSTAGRAM_CLIENT_ID, INSTAGRAM_CLIENT_SECRET, INSTAGRAM_GRAPH_API_VERSION,
# INSTAGRAM_REDIRECT_URI, TIKTOK_CLIENT_KEY, TIKTOK_REDIRECT_URI,
# SOCIAL_PUBLIC_BASE_URL, SOCIAL_TOKEN_ENCRYPTION_KEYS,
# SOCIAL_TOKEN_ENCRYPTION_CURRENT_VERSION, and INSTAGRAM_WEBHOOK_VERIFY_TOKEN.
# Remove legacy values only after the Zernio disposition is complete.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Provider worker (Cloud Run Job or local process)
# -----------------------------------------------------------------------------
PROVIDER_WORKER_ID=local-provider-worker
PROVIDER_WORKER_LOCK_MS=2700000
PROVIDER_WORKER_POLL_INTERVAL_MS=2000
PROVIDER_WORKER_TOOLS=stitchr,swapr,clipr,avatar-photo,swipr
PROVIDER_WORKER_FFMPEG_PATH=ffmpeg
PROVIDER_WORKER_FFPROBE_PATH=ffprobe

# -----------------------------------------------------------------------------
# Media worker (Cloud Run Job or local process)
# -----------------------------------------------------------------------------
# MEDIA_WORKER_SECRET, Convex, R2, and Replicate values above are reused.

# -----------------------------------------------------------------------------
# Studio Clips worker (separate Cloud Run Job; real execution is disabled by
# default and becomes available only when STUDIO_CLIPS_WORKER_QUEUE_ENABLED=true
# and every required coordinator, R2, provider, and media command value is set)
# STUDIO_CLIPS_WORKER_SECRET must match the Convex deployment and must not reuse
# the provider, media, publishing, or Studio operator secret.
# The worker independently requires both this queue switch and the global
# STUDIO_BETA_ENABLED switch to be exact lowercase true before it can claim.
# -----------------------------------------------------------------------------
STUDIO_CLIPS_WORKER_QUEUE_ENABLED=false
STUDIO_CLIPS_WORKER_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 32
STUDIO_CLIPS_WORKER_API_ORIGIN=http://localhost:3000
STUDIO_CLIPS_WORKER_ID=local-studio-clips-worker
STUDIO_CLIPS_WORKER_LEASE_SECONDS=300
STUDIO_CLIPS_WORKER_POLL_INTERVAL_MS=2000
STUDIO_CLIPS_WORKER_HTTP_TIMEOUT_MS=30000
STUDIO_CLIPS_WORKER_SCRATCH_ROOT=
STUDIO_CLIPS_FFMPEG_PATH=ffmpeg
STUDIO_CLIPS_FFPROBE_PATH=ffprobe
STUDIO_CLIPS_YT_DLP_PATH=yt-dlp
STUDIO_CLIPS_ANALYSIS_PROVIDER=google # google or openai
STUDIO_CLIPS_ANALYSIS_MODEL=gemini-2.5-flash
STUDIO_CLIPS_ASSEMBLYAI_POLL_INTERVAL_MS=3000
STUDIO_CLIPS_ASSEMBLYAI_TIMEOUT_MS=1800000
ASSEMBLYAI_API_KEY=PLACEHOLDER # SERVER_ONLY
GOOGLE_API_KEY=PLACEHOLDER # SERVER_ONLY; required for google analysis
OPENAI_API_KEY=PLACEHOLDER # SERVER_ONLY; required for openai analysis

# -----------------------------------------------------------------------------
# Studio Stitch execution worker (separate Cloud Run Job; disabled by default)
# This secret is shared only by the web coordinator and this worker. It must not
# reuse MEDIA_WORKER_SECRET, PROVIDER_WORKER_SECRET, or STUDIO_CLIPS_WORKER_SECRET.
# The worker also requires the global STUDIO_BETA_ENABLED switch above to be
# exact lowercase true and rechecks it independently before it can claim work.
# R2_* above are reused for owned inputs, checkpoints, and final outputs.
# -----------------------------------------------------------------------------
STUDIO_STITCH_EXECUTION_ENABLED=false
STUDIO_STITCH_WORKER_SECRET=PLACEHOLDER # SERVER_ONLY; openssl rand -base64 48
STUDIO_STITCH_WORKER_API_ORIGIN=http://localhost:3000
STUDIO_STITCH_WORKER_ID=local-studio-stitch-worker
STUDIO_STITCH_WORKER_LEASE_SECONDS=300
STUDIO_STITCH_WORKER_POLL_INTERVAL_MS=2000
STUDIO_STITCH_WORKER_HTTP_TIMEOUT_MS=30000
STUDIO_STITCH_WORKER_SCRATCH_ROOT=
STUDIO_STITCH_FFMPEG_PATH=ffmpeg
STUDIO_STITCH_FFPROBE_PATH=ffprobe
STUDIO_STITCH_FONT_PATH=/app/services/studio-stitch-worker/assets/TikTokSans-Regular.ttf
# Comma-separated exact HTTPS hostnames returned by DanSUGC purchase responses.
# Keep empty while DanSUGC is disabled; never use wildcards or URL prefixes.
STUDIO_STITCH_DANSUGC_DOWNLOAD_HOSTS=
DANSUGC_API_KEY=PLACEHOLDER # SERVER_ONLY; optional reaction sourcing
GEMINI_API_KEY=PLACEHOLDER # SERVER_ONLY; optional grounded demo analysis
ELEVENLABS_API_KEY=PLACEHOLDER # SERVER_ONLY; required for provider-timed talking voice

# -----------------------------------------------------------------------------
# Hook Lab social import
# -----------------------------------------------------------------------------
HOOK_LAB_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
HOOK_LAB_INSTAGRAM_ACTOR_ID=apify/instagram-scraper
HOOK_LAB_APIFY_MAX_TOTAL_CHARGE_USD=0.5
HOOK_LAB_IMPORTED_VIDEO_MAX_BYTES=104857600
HOOK_LAB_VIDEO_MAX_DURATION_SECONDS=180
HOOK_LAB_TEXT_MODEL_ID=

# -----------------------------------------------------------------------------
# TikTok analytics pixel/events (separate from publishing OAuth credentials)
# -----------------------------------------------------------------------------
# TikTok
NEXT_PUBLIC_TIKTOK_PIXEL_ID=PLACEHOLDER
TIKTOK_EVENTS_API_ACCESS_TOKEN=PLACEHOLDER # SERVER_ONLY
TIKTOK_EVENTS_API_TEST_EVENT_CODE=PLACEHOLDER

# -----------------------------------------------------------------------------
# PostHog analytics
# -----------------------------------------------------------------------------
# Zernio
SOCIAL_PUBLISHING_API_KEY_ENCRYPTION_SECRET=PLACEHOLDER # openssl rand -base64 32
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
SOCIAL_PUBLISHING_MAX_MEDIA_BYTES=262144000

# Posthog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=PLACEHOLDER
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Google Cloud Run worker dispatch
# Required by Convex when dispatching worker jobs. The private key is
# SERVER_ONLY and must retain escaped newlines when stored in an env value.
# -----------------------------------------------------------------------------
CLOUD_RUN_PROJECT_ID=clipstitchr
CLOUD_RUN_LOCATION=us-central1
CLOUD_RUN_PROVIDER_WORKER_JOB=clipstitchr-provider-worker
CLOUD_RUN_MEDIA_WORKER_JOB=clipstitchr-media-worker
CLOUD_RUN_DISPATCH_CLIENT_EMAIL=PLACEHOLDER # SERVER_ONLY
CLOUD_RUN_DISPATCH_PRIVATE_KEY=PLACEHOLDER # SERVER_ONLY
