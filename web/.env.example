# Media worker
#
# These are shown here for discovery, but the plain Node worker does not
# automatically load .env.local. For local worker runs, copy .env.worker.example
# to .env.worker.local and source it before `npm run media-worker`.
MEDIA_WORKER_SECRET=PLACEHOLDER # openssl rand -base64 32
MEDIA_WORKER_ID=local-media-worker
MEDIA_WORKER_SCRATCH_DIR=/tmp/clipstitchr-media-worker
MEDIA_WORKER_POLL_INTERVAL_MS=2000
MEDIA_WORKER_LOCK_MS=300000

# Google Cloud execution layer
#
# These are for the recommended future Cloud Run / Cloud Tasks / Scheduler
# execution path. They are not all consumed by the current app yet. See
# .env.automation.example for the full local automation/dispatcher template.
GOOGLE_CLOUD_PROJECT_ID=PLACEHOLDER
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=PLACEHOLDER # local path only; prefer ADC locally
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=PLACEHOLDER # Vercel/external host only if needed
GOOGLE_CLOUD_RUN_MEDIA_JOB_NAME=clipstitchr-media-worker
GOOGLE_CLOUD_TASKS_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=clipstitchr-automation
GOOGLE_CLOUD_TASKS_PROVIDER_URL=PLACEHOLDER
GOOGLE_CLOUD_TASKS_OIDC_SERVICE_ACCOUNT_EMAIL=PLACEHOLDER
PROVIDER_WORKER_SECRET=PLACEHOLDER # openssl rand -base64 32
AUTOMATION_WORKER_SECRET=PLACEHOLDER # openssl rand -base64 32
