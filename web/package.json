{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "services/publishing-service"
  ],
  "scripts": {
    "predev": "npm run publishing-service:build",
    "predev:webpack": "npm run publishing-service:build",
    "content:build": "node ./scripts/build-content-collections.mjs",
    "content:watch": "node ./scripts/watch-content-collections.mjs",
    "dev": "node ./scripts/run-dev-server.mjs",
    "dev:webpack": "node ./scripts/run-dev-server.mjs --webpack",
    "build": "npm run content:build && npm run publishing-service:build && next build",
    "start": "next start",
    "lint": "npm run content:build && eslint .",
    "lazyreel:verify-vendor": "node ./vendor/lazyreel/v0_1_0/verify-snapshot.mjs",
    "media-worker": "node ./services/media-worker/runMediaWorker.mjs",
    "opencut:verify-vendor": "node ./vendor/opencut/classic_cf5e79e/verify-snapshot.mjs",
    "opencut-rewrite:verify-vendor": "node ./vendor/opencut/rewrite_supplied_8eefd45a/verify-snapshot.mjs",
    "postiz:verify-vendor": "node ./vendor/postiz/official_013db1da/verify-snapshot.mjs",
    "publishing-service:build": "npm run build --workspace @clipstitchr/publishing-service",
    "publishing-service:test": "npm test --workspace @clipstitchr/publishing-service",
    "publishing-service:test:postgres": "npm run test:postgres --workspace @clipstitchr/publishing-service",
    "publishing-service:test:redis": "npm run test:redis --workspace @clipstitchr/publishing-service",
    "publishing-service:typecheck": "npm run typecheck --workspace @clipstitchr/publishing-service",
    "provider-worker": "tsx ./services/provider-worker/runProviderWorker.ts",
    "reelclaw:verify-vendor": "node ./vendor/reelclaw/snapshot_bdeb17ca/verify-snapshot.mjs",
    "studio-beta:grant": "node --env-file-if-exists=.env.local ./scripts/studio-beta/grantStudioBetaAccess.mjs",
    "studio-beta:list": "node --env-file-if-exists=.env.local ./scripts/studio-beta/listStudioBetaAccess.mjs",
    "studio-beta:revoke": "node --env-file-if-exists=.env.local ./scripts/studio-beta/revokeStudioBetaAccess.mjs",
    "supoclip:verify-vendor": "node ./vendor/supoclip/v0_1_0/verify-snapshot.mjs",
    "submit:indexnow": "node --env-file-if-exists=.env.local ./scripts/submit-indexnow.mjs",
    "typecheck": "npm run content:build && tsc --noEmit && npm run publishing-service:typecheck",
    "test": "npm run content:build && vitest run --coverage && npm run publishing-service:test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@base-ui/react": "^1.6.0",
    "@clerk/backend": "^3.11.6",
    "@clerk/nextjs": "^7.3.2",
    "@content-collections/core": "^0.15.0",
    "@content-collections/mdx": "^0.2.2",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/stripe": "^0.1.6",
    "@mediabunny/aac-encoder": "^1.44.0",
    "@vercel/analytics": "^2.0.1",
    "convex": "^1.38.0",
    "loops": "^7.0.0",
    "lucide-react": "^1.14.0",
    "mediabunny": "^1.44.0",
    "next": "16.3.0",
    "posthog-js": "^1.373.5",
    "posthog-node": "^5.34.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "stripe": "^22.2.1",
    "tsx": "^4.22.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@>=3": "5.0.9",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.23",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "ws": "^8.20.2"
  }
}
