{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content:build": "node ./scripts/build-content-collections.mjs",
    "content:watch": "node ./scripts/watch-content-collections.mjs",
    "dev": "node ./scripts/run-dev-server.mjs",
    "dev:webpack": "node ./scripts/run-dev-server.mjs --webpack",
    "build": "npm run content:build && next build",
    "start": "next start",
    "lint": "npm run content:build && eslint .",
    "media-worker": "node ./services/media-worker/runMediaWorker.mjs",
    "provider-worker": "tsx ./services/provider-worker/runProviderWorker.ts",
    "submit:indexnow": "node --env-file-if-exists=.env.local ./scripts/submit-indexnow.mjs",
    "typecheck": "npm run content:build && tsc --noEmit",
    "test": "npm run content:build && vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@clerk/nextjs": "^7.3.2",
    "@content-collections/core": "^0.15.0",
    "@content-collections/mdx": "^0.2.2",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@mediabunny/aac-encoder": "^1.44.0",
    "@vercel/analytics": "^2.0.1",
    "convex": "^1.38.0",
    "lucide-react": "^1.14.0",
    "mediabunny": "^1.44.0",
    "next": "16.2.6",
    "posthog-js": "^1.373.5",
    "posthog-node": "^5.34.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.4.0",
    "tsx": "^4.22.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
  "js-yaml": "^4.1.2",
  "postcss": "^8.5.10",
  "uuid": "^11.1.1",
  "ws": "^8.20.2"
  }
}
