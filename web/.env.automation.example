# Automation environment values.
#
# Copy only the values for the deployment you are configuring. Do not commit
# real secrets.

# Convex deployment environment.
#
# Required when Convex Cron dispatches the Next.js automation provider routes.
# Use the production app origin only, with no path.
AUTOMATION_NEXT_BASE_URL=https://clipstitchr.com

# Required in both Convex and the Next.js app. The value must match exactly.
# Generate with: openssl rand -base64 32
AUTOMATION_WORKER_SECRET=PLACEHOLDER

# Must match MEDIA_WORKER_SECRET in the Cloud Worker deployment environment.
# Generate with: openssl rand -base64 32
MEDIA_WORKER_SECRET=PLACEHOLDER

# Optional Convex automation window. Defaults are shown here.
AUTOMATION_GLOBAL_WINDOW_START_UTC=09:00
AUTOMATION_GLOBAL_WINDOW_END_UTC=13:00

# Next.js app environment for automation routes.
#
# Required so the automation routes can claim and update Convex tasks.
NEXT_PUBLIC_CONVEX_URL=PLACEHOLDER

# Required for Swapr/Clipr automation routes to read and write R2 objects.
R2_ACCOUNT_ID=PLACEHOLDER
R2_BUCKET_NAME=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER

# Required for provider execution through Replicate.
REPLICATE_API_TOKEN=PLACEHOLDER

# Optional provider model overrides. Omit these to use the code defaults.
CLIPR_HOOK_MODEL_ID=PLACEHOLDER
CLIPR_AVATAR_VIDEO_MODEL_ID=PLACEHOLDER
AVATAR_PHOTO_MODEL_ID=PLACEHOLDER
