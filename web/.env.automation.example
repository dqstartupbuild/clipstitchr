# Local automation/provider execution environment.
#
# Copy this file to .env.automation.local for local experiments. Do not commit
# .env.automation.local. The production values live in the host that runs the
# executor: Google Cloud Run services/jobs, Vercel if it dispatches jobs, and
# Convex for secrets Convex must verify.
#
# Not every variable here is consumed by current code yet. This is the planned
# credential map for the recommended Convex + R2 + Google execution path.

# Convex state ledger.
NEXT_PUBLIC_CONVEX_URL=PLACEHOLDER

# Server-only secrets that must match the Convex deployment when Convex verifies
# worker/finalizer mutations. Generate with: openssl rand -base64 32
RATE_LIMIT_API_SECRET=PLACEHOLDER
MEDIA_WORKER_SECRET=PLACEHOLDER
PROVIDER_WORKER_SECRET=PLACEHOLDER
AUTOMATION_WORKER_SECRET=PLACEHOLDER

# Cloudflare R2 storage used by provider finalizers and media workers.
R2_ACCOUNT_ID=PLACEHOLDER
R2_BUCKET_NAME=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER

# Provider credentials used by provider executors/finalizers.
REPLICATE_API_TOKEN=PLACEHOLDER
REPLICATE_UPLOAD_ANALYSIS_MODEL_ID=PLACEHOLDER
REPLICATE_UPLOAD_VIDEO_ANALYSIS_MODEL_ID=PLACEHOLDER
PRODUCT_ENRICHMENT_MODEL_ID=PLACEHOLDER
CLIPR_HOOK_MODEL_ID=PLACEHOLDER
CLIPR_SCENE_MODEL_ID=PLACEHOLDER
CLIPR_AVATAR_VIDEO_MODEL_ID=PLACEHOLDER
CLIPR_MUSIC_MODEL_ID=PLACEHOLDER
SWIPR_BACKGROUND_MODEL_ID=PLACEHOLDER
AVATAR_PHOTO_MODEL_ID=PLACEHOLDER

# Google Cloud project and local credentials.
GOOGLE_CLOUD_PROJECT_ID=PLACEHOLDER
GOOGLE_CLOUD_LOCATION=us-central1

# Local development can use either Application Default Credentials:
#   gcloud auth application-default login
# or a local service-account JSON file path. Do not commit JSON credentials.
GOOGLE_APPLICATION_CREDENTIALS=PLACEHOLDER

# Use this only when an external host such as Vercel must call Google APIs and
# Workload Identity Federation is not configured. Store the base64-encoded JSON
# as a secret, never in source control.
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=PLACEHOLDER

# Cloud Run Job used for bounded media-worker execution.
GOOGLE_CLOUD_RUN_MEDIA_JOB_NAME=clipstitchr-media-worker
GOOGLE_CLOUD_RUN_MEDIA_JOB_REGION=us-central1

# Cloud Run services used for provider executors/finalizers and autopilot
# planning. These are target URLs for Cloud Tasks or Scheduler.
GOOGLE_CLOUD_RUN_PROVIDER_SERVICE_URL=PLACEHOLDER
GOOGLE_CLOUD_RUN_AUTOPILOT_PLANNER_URL=PLACEHOLDER

# Cloud Tasks queue used for provider work, retries, and finalization.
GOOGLE_CLOUD_TASKS_PROJECT_ID=PLACEHOLDER
GOOGLE_CLOUD_TASKS_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=clipstitchr-automation
GOOGLE_CLOUD_TASKS_PROVIDER_URL=PLACEHOLDER
GOOGLE_CLOUD_TASKS_OIDC_SERVICE_ACCOUNT_EMAIL=PLACEHOLDER

# Cloud Scheduler job location and authenticated target for daily autopilot.
GOOGLE_CLOUD_SCHEDULER_LOCATION=us-central1
GOOGLE_CLOUD_SCHEDULER_AUTOPILOT_TARGET_URL=PLACEHOLDER
GOOGLE_CLOUD_SCHEDULER_OIDC_SERVICE_ACCOUNT_EMAIL=PLACEHOLDER

# Optional automation tuning. The app uses one global UTC generation window;
# users do not set per-account timezones or preferred generation hours.
AUTOPILOT_DAILY_PLANNER_CRON=0 * * * *
AUTOMATION_GLOBAL_WINDOW_START_UTC=09:00
AUTOMATION_GLOBAL_WINDOW_END_UTC=13:00
AUTOPILOT_MAX_USERS_PER_PLANNER_RUN=100
AUTOPILOT_MAX_TASKS_PER_USER_PER_DAY=10
