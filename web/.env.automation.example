# Automation environment values.
#
# Copy only the values for the deployment you are configuring. Do not commit
# real secrets.

# Convex deployment environment.
#
# Required in Convex and by any trusted planner/manual automation trigger.
# Generate with: openssl rand -base64 32
AUTOMATION_WORKER_SECRET=PLACEHOLDER

# Convex automation callbacks should target the app origin for this deployment.
# Use https://clipstitchr.com for production.
AUTOMATION_NEXT_BASE_URL=PLACEHOLDER

# Required in Convex and by the provider worker only.
# Generate with: openssl rand -base64 32
PROVIDER_WORKER_SECRET=PLACEHOLDER

# Must match MEDIA_WORKER_SECRET in the Cloud Worker deployment environment.
# Generate with: openssl rand -base64 32
MEDIA_WORKER_SECRET=PLACEHOLDER

# Optional Convex automation window. Defaults are shown here.
AUTOMATION_GLOBAL_WINDOW_START_UTC=09:00
AUTOMATION_GLOBAL_WINDOW_END_UTC=13:00

# Required in Convex when worker dispatch uses Google Cloud Run Jobs.
CLOUD_RUN_PROJECT_ID=clipstitchr
CLOUD_RUN_LOCATION=us-central1
CLOUD_RUN_PROVIDER_WORKER_JOB=clipstitchr-provider-worker
CLOUD_RUN_MEDIA_WORKER_JOB=clipstitchr-media-worker
CLOUD_RUN_DISPATCH_CLIENT_EMAIL=PLACEHOLDER
CLOUD_RUN_DISPATCH_PRIVATE_KEY=PLACEHOLDER
