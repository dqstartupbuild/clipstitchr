<H1 paddingBottom="12">Confirm your email</H1>
<Paragraph paddingBottom="20">Confirm that you want to hear from ClipStitchr. If you requested a course or workshop, this also opens it.</Paragraph>
<Button href="{data.confirmationUrl}" bgColor="#ddb498" textColor="#1c120e" borderRadius="8" align="left" notrack="true" paddingBottom="20">Confirm my email</Button>
