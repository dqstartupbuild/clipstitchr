# Local media worker environment.
#
# Copy this file to .env.worker.local for local development. Do not commit
# .env.worker.local. The worker is a plain Node process, so Next.js does not
# automatically load web/.env.local for it. The worker command does
# automatically load .env.worker.local from this directory when present.
#
# Local run command:
#   npm run media-worker
#
# Local support check without claiming jobs:
#   npm run media-worker -- --check
#
# Bounded Cloud Run-style local test:
#   npm run media-worker -- --once --max-jobs=3

# Convex deployment the worker should claim jobs from.
NEXT_PUBLIC_CONVEX_URL=PLACEHOLDER

# Must match MEDIA_WORKER_SECRET in the Convex deployment environment.
# Generate with: openssl rand -base64 32
MEDIA_WORKER_SECRET=PLACEHOLDER

# Required when the worker completes automation-owned media jobs and marks the
# automation task/run complete. Must match the Convex deployment environment.
AUTOMATION_WORKER_SECRET=PLACEHOLDER

# R2 credentials used by the worker to download sources and upload outputs.
R2_ACCOUNT_ID=PLACEHOLDER
R2_BUCKET_NAME=PLACEHOLDER
R2_ACCESS_KEY_ID=PLACEHOLDER
R2_SECRET_ACCESS_KEY=PLACEHOLDER

# If this process runs as a Google Cloud Run Job, these same values should be
# configured on the Cloud Run Job as secrets/environment variables. Google Cloud
# credentials are not needed inside the worker unless the worker itself calls
# Google APIs; the job launcher/dispatcher owns that.

# Optional. Used only when a Swapr provider output URL is an authenticated
# api.replicate.com read rather than a public replicate.delivery URL.
REPLICATE_API_TOKEN=PLACEHOLDER
